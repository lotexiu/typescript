{
  "name": "@lotexiu/typescript",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotexiu/typescript.git"
  },
  "homepage": "https://github.com/lotexiu/typescript#readme",
  "bugs": {
    "url": "https://github.com/lotexiu/typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "signals",
    "reactive",
    "headless",
    "accessibility",
    "aria",
    "mask",
    "theme",
    "color",
    "temporal",
    "decimal",
    "parser",
    "grammar",
    "animation",
    "typescript",
    "lotexiu"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm docs:check && vite build && pnpm dist:prepare",
    "prepare": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:ui": "vitest --ui --passWithNoTests",
    "clean": "rm -rf dist",
    "docs:ast": "tsx src/.scripts/doc/generate.ts",
    "docs:check": "tsx src/.scripts/doc/generate.ts --check",
    "docs:strict": "tsx src/.scripts/doc/generate.ts --check --require-docs",
    "dist:prepare": "tsx src/.scripts/publish/prepare.ts",
    "release": "pnpm build && npm publish ./dist --access public"
  },
  "devDependencies": {
    "@lotexiu/typescript-config": "workspace:*",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^26.0.0",
    "@vitest/ui": "4.1.9",
    "chokidar": "^4.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.19.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "colorjs.io": "^0.6.1"
  },
  "sideEffects": true,
  "typings": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.ts",
  "description": "Primitivos agnósticos de framework: signals, controles headless com acessibilidade, máscaras, tempo, decimais, temas com contraste, motor de gramática, animação e mais — uma dependência de runtime só (colorjs.io).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
